@page

<!-- Dashboard Page -->
<div class="dashboard-container">
    <!-- Welcome Section -->
    <section class="py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
        <div class="container" data-aos="fade-up">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-5 fw-bold mb-2">Welcome, <span id="userName">Guest</span>! 👋</h1>
                    <p class="lead">Here's what's happening with your events today</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/Events" class="btn btn-light btn-lg fw-bold">
                        <i class="fas fa-plus me-2"></i>Explore More Events
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4 mb-5" data-aos="fade-up">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"><i class="fas fa-ticket"></i></div>
                        <div class="stat-content">
                            <h6 class="text-muted mb-1">Bookings</h6>
                            <h3 class="fw-bold" id="bookingCount">0</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);"><i class="fas fa-calendar"></i></div>
                        <div class="stat-content">
                            <h6 class="text-muted mb-1">Upcoming</h6>
                            <h3 class="fw-bold" id="upcomingCount">0</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"><i class="fas fa-heart"></i></div>
                        <div class="stat-content">
                            <h6 class="text-muted mb-1">Favorites</h6>
                            <h3 class="fw-bold" id="favoriteCount">0</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);"><i class="fas fa-users"></i></div>
                        <div class="stat-content">
                            <h6 class="text-muted mb-1">Guests</h6>
                            <h3 class="fw-bold" id="guestCount">0</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- My Bookings -->
            <div class="row">
                <div class="col-md-8">
                    <div data-aos="fade-up">
                        <div class="d-flex align-items-center mb-4">
                            <h3 class="fw-bold mb-0">My Bookings</h3>
                            <span class="badge bg-primary ms-3" id="totalBookings">0</span>
                        </div>

                        <div id="bookingsList">
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-alt" style="font-size: 3rem; color: #ddd;"></i>
                                <p class="text-muted mt-3">No bookings yet. <a href="/Events">Browse events</a></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Profile Card -->
                <div class="col-md-4">
                    <div class="profile-card" data-aos="fade-up" data-aos-delay="100">
                        <div class="profile-header">
                            <div class="profile-avatar" id="profileAvatar">👤</div>
                        </div>
                        <div class="profile-content">
                            <h5 class="fw-bold" id="profileName">Guest User</h5>
                            <p class="text-muted small" id="profileEmail">guest@example.com</p>
                            
                            <hr>

                            <div class="profile-stats mb-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Member Since</span>
                                    <span class="fw-bold" id="memberSince">Today</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Status</span>
                                    <span class="badge bg-success">Active</span>
                                </div>
                            </div>

                            <a href="#" class="btn btn-outline-primary w-100 btn-sm mb-2">
                                <i class="fas fa-edit me-2"></i>Edit Profile
                            </a>
                            <a href="#" class="btn btn-outline-secondary w-100 btn-sm mb-2">
                                <i class="fas fa-key me-2"></i>Change Password
                            </a>
                            <button onclick="handleLogout()" class="btn btn-danger w-100 btn-sm">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Actions -->
    <section class="py-5 bg-light">
        <div class="container">
            <h3 class="fw-bold mb-4" data-aos="fade-down">Quick Actions</h3>
            <div class="row g-4" data-aos="fade-up">
                <div class="col-md-4">
                    <div class="action-card">
                        <div class="action-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"><i class="fas fa-search"></i></div>
                        <h6 class="fw-bold mt-3">Discover Events</h6>
                        <p class="text-muted small">Browse our collection of amazing events</p>
                        <a href="/Events" class="btn btn-sm btn-primary">Explore</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="action-card">
                        <div class="action-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);"><i class="fas fa-images"></i></div>
                        <h6 class="fw-bold mt-3">Event Gallery</h6>
                        <p class="text-muted small">View beautiful event photos and galleries</p>
                        <a href="/Gallery" class="btn btn-sm btn-primary">View Gallery</a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="action-card">
                        <div class="action-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);"><i class="fas fa-headset"></i></div>
                        <h6 class="fw-bold mt-3">Contact Support</h6>
                        <p class="text-muted small">Need help? Our team is always here</p>
                        <a href="/Contact" class="btn btn-sm btn-primary">Get Help</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Check if user is logged in
    if (!isLoggedIn()) {
        showToast('Please login to access dashboard', 'warning');
        setTimeout(() => {
            window.location.href = '/Login';
        }, 1500);
        return;
    }
    loadDashboardData();
});

function loadDashboardData() {
    const user = getCurrentUser();
    
    if (!user) {
        window.location.href = '/Login';
        return;
    }

    // Update user info
    document.getElementById('userName').textContent = user.fullName || 'User';
    document.getElementById('profileName').textContent = user.fullName || 'User';
    document.getElementById('profileEmail').textContent = user.email || '';
    document.getElementById('memberSince').textContent = new Date().toLocaleDateString();

    // Get user's bookings
    const allBookings = JSON.parse(localStorage.getItem('bookings')) || [];
    const userBookings = allBookings.filter(b => b.email.toLowerCase() === user.email.toLowerCase());

    // Update stats
    document.getElementById('bookingCount').textContent = userBookings.length;
    document.getElementById('totalBookings').textContent = userBookings.length;
    
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const upcomingBookings = userBookings.filter(b => {
        const eventDate = new Date(b.eventDate);
        eventDate.setHours(0, 0, 0, 0);
        return eventDate >= today && b.status !== 'Cancelled';
    });
    document.getElementById('upcomingCount').textContent = upcomingBookings.length;
    
    const totalGuests = userBookings.reduce((sum, b) => sum + (parseInt(b.guestCount) || 0), 0);
    document.getElementById('guestCount').textContent = totalGuests;

    // Display bookings
    const bookingsList = document.getElementById('bookingsList');
    if (userBookings.length > 0) {
        bookingsList.innerHTML = '';
        
        userBookings.slice(0, 5).forEach(booking => {
            const bookingCard = document.createElement('div');
            bookingCard.className = 'booking-card mb-3 p-3';
            bookingCard.style.borderLeft = booking.status === 'Cancelled' ? '5px solid #dc3545' : '5px solid #667eea';
            
            const statusBadgeColor = {
                'Confirmed': 'success',
                'Pending': 'warning',
                'Completed': 'info',
                'Cancelled': 'danger'
            }[booking.status] || 'secondary';
            
            bookingCard.innerHTML = `
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6 class="fw-bold mb-2">${booking.eventType} Event</h6>
                        <p class="text-muted small mb-1"><i class="fas fa-calendar"></i> ${new Date(booking.eventDate).toLocaleDateString()}</p>
                        <p class="text-muted small mb-1"><i class="fas fa-map-pin"></i> ${booking.venue}</p>
                        <p class="text-muted small"><i class="fas fa-users"></i> ${booking.guestCount} guests</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="badge bg-${statusBadgeColor}">${booking.status}</span>
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary" onclick="viewBookingDetails('${booking.id}')">View</button>
                            ${booking.status !== 'Cancelled' ? `<button class="btn btn-sm btn-outline-danger" onclick="cancelBooking('${booking.id}', '${booking.email}')">Cancel</button>` : ''}
                        </div>
                    </div>
                </div>
            `;
            bookingsList.appendChild(bookingCard);
        });

        if (userBookings.length > 5) {
            const viewAllBtn = document.createElement('div');
            viewAllBtn.className = 'text-center mt-3';
            viewAllBtn.innerHTML = `<a href="/BookingStatus" class="btn btn-outline-primary">View All Bookings</a>`;
            bookingsList.appendChild(viewAllBtn);
        }
    } else {
        bookingsList.innerHTML = `
            <div class="text-center py-5">
                <i class="fas fa-calendar-alt" style="font-size: 3rem; color: #ddd;"></i>
                <p class="text-muted mt-3">No bookings yet. <a href="/Events">Browse events</a></p>
            </div>
        `;
    }
}

function viewBookingDetails(bookingId) {
    const allBookings = JSON.parse(localStorage.getItem('bookings')) || [];
    const booking = allBookings.find(b => b.id === bookingId);

    if (booking) {
        alert(`Booking Details:

Booking ID: ${booking.id}
Name: ${booking.name}
Event Type: ${booking.eventType}
Event Date: ${new Date(booking.eventDate).toLocaleDateString()}
Guests: ${booking.guestCount}
Venue: ${booking.venue}
Total: $${booking.totalAmount}
Status: ${booking.status}
Booked on: ${new Date(booking.bookingDate).toLocaleString()}`);
    }
}

function cancelBooking(bookingId, email) {
    if (!confirm('Are you sure you want to cancel this booking?')) return;

    const bookings = JSON.parse(localStorage.getItem('bookings')) || [];
    const bookingIndex = bookings.findIndex(b => b.id === bookingId);

    if (bookingIndex !== -1) {
        bookings[bookingIndex].status = 'Cancelled';
        localStorage.setItem('bookings', JSON.stringify(bookings));
        loadDashboardData();
        showToast('Booking cancelled successfully', 'success');
    }
}

function handleLogout() {
    if (confirm('Are you sure you want to logout?')) {
        logout();
    }
}
</script>
