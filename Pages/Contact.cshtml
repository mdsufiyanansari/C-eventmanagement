@page

<!-- Contact Page -->
<div class="contact-container">
    <!-- Page Header -->
    <section class="page-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 0;">
        <div class="container" data-aos="fade-up">
            <h1 class="display-4 fw-bold">Get In Touch</h1>
            <p class="lead">We're here to help and answer any questions you might have</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="py-5">
        <div class="container">
            <div class="row g-5">
                <!-- Contact Form -->
                <div class="col-lg-8" data-aos="fade-up">
                    <div class="contact-form-card">
                        <h3 class="fw-bold mb-4">Send us a Message</h3>
                        <form onsubmit="handleContactSubmit(event)">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <input type="text" class="form-control form-control-lg" placeholder="John Doe" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email Address</label>
                                    <input type="email" class="form-control form-control-lg" placeholder="your@email.com" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Phone Number</label>
                                    <input type="tel" class="form-control form-control-lg" placeholder="+1 (555) 000-0000" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Subject</label>
                                    <select class="form-select form-select-lg" required>
                                        <option selected>Select a subject</option>
                                        <option value="Event Booking">Event Booking</option>
                                        <option value="General Inquiry">General Inquiry</option>
                                        <option value="Technical Support">Technical Support</option>
                                        <option value="Partnership">Partnership</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Message</label>
                                    <textarea class="form-control" rows="5" placeholder="Type your message here..." required></textarea>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="privacyCheck" required>
                                        <label class="form-check-label" for="privacyCheck">
                                            I agree to the privacy policy
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg mt-4 w-100">
                                <i class="fas fa-paper-plane me-2"></i>Send Message
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <!-- Info Cards -->
                    <div class="contact-info-card mb-4">
                        <div class="info-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <h6 class="fw-bold mt-3">Address</h6>
                        <p class="text-muted">123 Event Street<br>New York, NY 10001<br>United States</p>
                    </div>

                    <div class="contact-info-card mb-4">
                        <div class="info-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <i class="fas fa-phone"></i>
                        </div>
                        <h6 class="fw-bold mt-3">Phone</h6>
                        <p class="text-muted">
                            +1 (555) 123-4567<br>
                            <a href="tel:+15551234568" class="text-decoration-none">+1 (555) 123-4568</a>
                        </p>
                    </div>

                    <div class="contact-info-card mb-4">
                        <div class="info-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <h6 class="fw-bold mt-3">Email</h6>
                        <p class="text-muted">
                            <a href="mailto:info@eventpro.com" class="text-decoration-none">info@eventpro.com</a><br>
                            <a href="mailto:support@eventpro.com" class="text-decoration-none">support@eventpro.com</a>
                        </p>
                    </div>

                    <div class="contact-info-card">
                        <div class="info-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h6 class="fw-bold mt-3">Hours</h6>
                        <p class="text-muted">
                            Monday - Friday: 9:00 AM - 6:00 PM<br>
                            Saturday: 10:00 AM - 4:00 PM<br>
                            Sunday: Closed
                        </p>
                    </div>

                    <!-- Social Links -->
                    <div class="social-links mt-5">
                        <h6 class="fw-bold mb-3">Follow Us</h6>
                        <div class="d-flex gap-2">
                            <a href="#" class="btn btn-light btn-lg">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" class="btn btn-light btn-lg">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="btn btn-light btn-lg">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" class="btn btn-light btn-lg">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="py-5 bg-light">
        <div class="container" data-aos="fade-up">
            <h3 class="fw-bold mb-4 text-center">Our Location</h3>
            <div class="map-container">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3024.2219901290355!2d-74.00601692346899!3d40.71282507138267!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25a27e4f3b0a7%3A0xc4c3e0e1b8f5b5d2!2sNew%20York%2C%20NY!5e0!3m2!1sen!2sus!4v1" width="100%" height="400" style="border:0; border-radius: 8px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-5">
        <div class="container">
            <h3 class="fw-bold mb-5 text-center" data-aos="fade-down">Frequently Asked Questions</h3>
            <div class="row">
                <div class="col-lg-8 offset-lg-2" data-aos="fade-up">
                    <div class="accordion" id="faqAccordion2">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1Contact">
                                    How long does it take to respond to inquiries?
                                </button>
                            </h2>
                            <div id="faq1Contact" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion2">
                                <div class="accordion-body">
                                    We typically respond to all inquiries within 24 hours on business days. For urgent matters, please call our phone number.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2Contact">
                                    What's the best way to reach you?
                                </button>
                            </h2>
                            <div id="faq2Contact" class="accordion-collapse collapse" data-bs-parent="#faqAccordion2">
                                <div class="accordion-body">
                                    You can reach us through email, phone, or our contact form. For technical issues, email is usually the fastest. For urgent matters, please call us.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3Contact">
                                    Do you offer bulk inquiries?
                                </button>
                            </h2>
                            <div id="faq3Contact" class="accordion-collapse collapse" data-bs-parent="#faqAccordion2">
                                <div class="accordion-body">
                                    Yes, we offer special rates for bulk bookings and corporate events. Please contact our corporate team for more information.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4Contact">
                                    What are your business hours?
                                </button>
                            </h2>
                            <div id="faq4Contact" class="accordion-collapse collapse" data-bs-parent="#faqAccordion2">
                                <div class="accordion-body">
                                    We are open Monday to Friday from 9 AM to 6 PM, and Saturday from 10 AM to 4 PM (EST). We are closed on Sundays.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
function handleContactSubmit(event) {
    event.preventDefault();
    showToast('Thank you for your message! We will get back to you soon.');
    event.target.reset();
}
</script>