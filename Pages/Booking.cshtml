@page
@model BookingModel

<!-- Booking Page -->
<div class="booking-container">
    <!-- Success Message -->
    <div id="successAlert" class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px; display: none;">
        <h4 class="alert-heading"><i class="fas fa-check-circle"></i> Booking Created Successfully!</h4>
        <p id="successMessage"></p>
        <hr>
        <p class="mb-0">Your booking has been saved. You can track your booking status <a href="/BookingStatus">here</a>.</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- Page Header -->
    <section class="page-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 0;">
        <div class="container" data-aos="fade-up">
            <h1 class="display-4 fw-bold">Book Your Event</h1>
            <p class="lead">Complete your event booking in simple steps</p>
        </div>
    </section>

    <!-- Booking Form -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Form -->
                <div class="col-lg-8" data-aos="fade-up">
                    <div class="booking-form">
                        <!-- Personal Information -->
                        <div class="form-section mb-5">
                            <h4 class="fw-bold mb-4">
                                <span class="badge bg-primary me-2">1</span>Your Information
                            </h4>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <input type="text" name="name" class="form-control form-control-lg" placeholder="John Doe" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email</label>
                                    <input type="email" name="email" class="form-control form-control-lg" placeholder="your@email.com" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Phone</label>
                                    <input type="tel" name="phone" class="form-control form-control-lg" placeholder="+1 (555) 000-0000" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Date of Birth</label>
                                    <input type="date" name="dob" class="form-control form-control-lg" required>
                                </div>
                            </div>
                        </div>

                        <!-- Event Details -->
                        <div class="form-section mb-5">
                            <h4 class="fw-bold mb-4">
                                <span class="badge bg-primary me-2">2</span>Event Details
                            </h4>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Event Type</label>
                                    <select name="eventType" class="form-select form-select-lg" required onchange="updateEventType()">
                                        <option value="">Select event type</option>
                                        <option value="Wedding">Wedding</option>
                                        <option value="Birthday">Birthday</option>
                                        <option value="Corporate">Corporate</option>
                                        <option value="Concert">Concert</option>
                                        <option value="Party">Party</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Event Date</label>
                                    <input type="date" name="eventDate" class="form-control form-control-lg" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Guest Count</label>
                                    <input type="number" name="guestCount" class="form-control form-control-lg" placeholder="Number of guests" min="1" required onchange="calculateTotal()">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Location/Venue</label>
                                    <input type="text" name="venue" class="form-control form-control-lg" placeholder="Where is your event?" required>
                                </div>
                            </div>
                        </div>

                        <!-- Special Requests -->
                        <div class="form-section mb-5">
                            <h4 class="fw-bold mb-4">
                                <span class="badge bg-primary me-2">3</span>Special Requests
                            </h4>
                            <label class="form-label fw-bold">Any special requirements?</label>
                            <textarea name="specialRequests" class="form-control" rows="4" placeholder="Tell us about special requests, decorations, catering preferences, etc."></textarea>
                        </div>

                        <!-- Payment Method -->
                        <div class="form-section mb-5">
                            <h4 class="fw-bold mb-4">
                                <span class="badge bg-primary me-2">4</span>Payment Method
                            </h4>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="payment-option">
                                        <input type="radio" name="payment" id="paymentCard" value="Credit Card" required>
                                        <label for="paymentCard" class="w-100">
                                            <i class="fas fa-credit-card"></i> Credit/Debit Card
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option">
                                        <input type="radio" name="payment" id="paymentWallet" value="Digital Wallet">
                                        <label for="paymentWallet" class="w-100">
                                            <i class="fas fa-wallet"></i> Digital Wallet
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option">
                                        <input type="radio" name="payment" id="paymentBank" value="Bank Transfer">
                                        <label for="paymentBank" class="w-100">
                                            <i class="fas fa-university"></i> Bank Transfer
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="payment-option">
                                        <input type="radio" name="payment" id="paymentInstallment" value="Installment">
                                        <label for="paymentInstallment" class="w-100">
                                            <i class="fas fa-percentage"></i> Installment
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Terms -->
                        <div class="form-section mb-5">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="termsCheck" required>
                                <label class="form-check-label" for="termsCheck">
                                    I agree to the <a href="#" class="text-decoration-none">Terms & Conditions</a> and <a href="#" class="text-decoration-none">Cancellation Policy</a>
                                </label>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary btn-lg w-100 fw-bold" onclick="submitBooking(event)">
                            <i class="fas fa-check me-2"></i>Complete Booking
                        </button>
                    </div>
                </div>

                <!-- Booking Summary -->
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="booking-summary-card sticky-top" style="top: 100px;">
                        <h5 class="fw-bold mb-4">Booking Summary</h5>

                        <div class="summary-item">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Event Type</span>
                                <span class="fw-bold" id="summaryEventType">-</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Guests</span>
                                <span class="fw-bold" id="summaryGuests">0</span>
                            </div>
                        </div>

                        <hr style="border-color: rgba(255,255,255,0.3);">

                        <div class="summary-prices">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Per Guest Price</span>
                                <span>$50</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Service Fee (5%)</span>
                                <span id="serviceFee">$0</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span>Platform Fee</span>
                                <span>$10</span>
                            </div>
                        </div>

                        <hr style="border-color: rgba(255,255,255,0.3);">

                        <div class="d-flex justify-content-between fw-bold" style="font-size: 18px;">
                            <span>Total Amount</span>
                            <span id="totalAmount">$0</span>
                        </div>

                        <p class="text-white-50 mt-3 mb-0" style="font-size: 12px;">
                            <i class="fas fa-info-circle"></i> You can check your booking status <a href="/BookingStatus" style="color: white; text-decoration: underline;">here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
.booking-summary-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
}

.payment-option {
    border: 2px solid #ddd;
    padding: 15px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s;
}

.payment-option:hover {
    border-color: #667eea;
    background-color: #f8f9ff;
}

.payment-option input[type="radio"]:checked + label {
    color: #667eea;
    font-weight: bold;
}

.payment-option label {
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
}

.form-section {
    padding: 20px;
    background: #f8f9fa;
    border-radius: 8px;
}

.summary-item {
    padding: 0;
}
</style>

<script>
function updateEventType() {
    const eventType = document.querySelector('select[name="eventType"]').value;
    document.getElementById('summaryEventType').textContent = eventType || '-';
    calculateTotal();
}

function calculateTotal() {
    const guestCount = parseInt(document.querySelector('input[name="guestCount"]').value) || 0;
    const pricePerGuest = 50;
    const subtotal = guestCount * pricePerGuest;
    const serviceFee = Math.round(subtotal * 0.05);
    const platformFee = 10;
    const total = subtotal + serviceFee + platformFee;

    document.getElementById('summaryGuests').textContent = guestCount;
    document.getElementById('serviceFee').textContent = '$' + serviceFee;
    document.getElementById('totalAmount').textContent = '$' + total;
}

function getEventIdFromURL() {
    const params = new URLSearchParams(window.location.search);
    return parseInt(params.get('eventId')) || null;
}

function submitBooking(event) {
    event.preventDefault();

    const name = document.querySelector('input[name="name"]').value;
    const email = document.querySelector('input[name="email"]').value;
    const payment = document.querySelector('input[name="payment"]:checked');
    
    if (!name || !email || !payment) {
        alert('Please fill in all required fields');
        return;
    }

    const formData = {
        id: Date.now(),
        eventId: getEventIdFromURL() || 1,
        name: name,
        email: email,
        phone: document.querySelector('input[name="phone"]').value,
        dob: document.querySelector('input[name="dob"]').value,
        eventType: document.querySelector('select[name="eventType"]').value,
        guestCount: parseInt(document.querySelector('input[name="guestCount"]').value),
        venue: document.querySelector('input[name="venue"]').value,
        specialRequests: document.querySelector('textarea[name="specialRequests"]').value,
        paymentMethod: payment.value,
        totalAmount: document.getElementById('totalAmount').textContent.replace('$', ''),
        status: 'Confirmed',
        bookedAt: new Date().toISOString()
    };

    let bookings = JSON.parse(localStorage.getItem('bookings')) || [];
    bookings.push(formData);
    localStorage.setItem('bookings', JSON.stringify(bookings));

    document.getElementById('successMessage').textContent = `Your booking has been confirmed! Booking ID: ${formData.id}. Total Amount: $${formData.totalAmount}`;
    document.getElementById('successAlert').style.display = 'block';
    document.querySelector('.booking-form').reset();
    calculateTotal();

    window.scrollTo(0, 0);

    setTimeout(() => {
        window.location.href = '/BookingStatus?email=' + encodeURIComponent(formData.email);
    }, 3000);
}

document.addEventListener('DOMContentLoaded', function() {
    calculateTotal();
});
</script>
