@page

<!-- Hero Section -->
<section class="hero-section" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; color: white; position: relative; overflow: hidden;">
    <!-- Animated Background -->
    <div class="hero-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <div class="container text-center hero-content" data-aos="fade-up">
        <h1 class="hero-title display-3 fw-bold mb-4">Plan Your Perfect Event</h1>
        <p class="hero-subtitle lead fs-5 mb-4">From intimate gatherings to grand celebrations, we make every moment unforgettable</p>
        <div class="hero-buttons">
            <a href="/Events" class="btn btn-light btn-lg me-3 fw-bold">
                <i class="fas fa-calendar-days me-2"></i>Explore Events
            </a>
            <button class="btn btn-outline-light btn-lg fw-bold" data-bs-toggle="modal" data-bs-target="#bookingModal">
                <i class="fas fa-star me-2"></i>Plan Event
            </button>
        </div>
    </div>
</section>

<!-- Event Categories Section -->
<section class="py-5 categories-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-down">
            <h2 class="section-title fw-bold">Event Categories</h2>
