                    <div class="category-icon">
                        <i class="fas fa-ring"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Weddings</h5>
                    <p class="text-muted small">Celebrate your special day with elegance and charm</p>
                    <div class="category-badge">250+ Events</div>
                </div>
            </div>

            <!-- Birthday -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="category-card" onclick="filterCategory('Birthday')">
                    <div class="category-icon">
                        <i class="fas fa-cake-candles"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Birthdays</h5>
                    <p class="text-muted small">Make memories with friends and family members</p>
                    <div class="category-badge">180+ Events</div>
                </div>
            </div>

            <!-- Corporate -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
                <div class="category-card" onclick="filterCategory('Corporate')">
                    <div class="category-icon">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Corporate</h5>
                    <p class="text-muted small">Professional events for your business needs</p>
                    <div class="category-badge">320+ Events</div>
                </div>
            </div>

            <!-- Concert -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="400">
                <div class="category-card" onclick="filterCategory('Concert')">
                    <div class="category-icon">
                        <i class="fas fa-music"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Concerts</h5>
                    <p class="text-muted small">Live music and entertainment experiences</p>
                    <div class="category-badge">150+ Events</div>
                </div>
            </div>

            <!-- Party -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="500">
                <div class="category-card" onclick="filterCategory('Party')">
                    <div class="category-icon">
                        <i class="fas fa-champagne-glasses"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Parties</h5>
                    <p class="text-muted small">Fun-filled celebrations with great vibes</p>
                    <div class="category-badge">290+ Events</div>
                </div>
            </div>

            <!-- Other -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="600">
                <div class="category-card" onclick="filterCategory('Other')">
                    <div class="category-icon">
                        <i class="fas fa-sparkles"></i>
                    </div>
                    <h5 class="fw-bold mt-3">Special Events</h5>
                    <p class="text-muted small">Unique and memorable occasions</p>
                    <div class="category-badge">420+ Events</div>
                </div>
            </div>
        </div>
    </div>
</section>

