@page

<!-- Event Details Page -->
<div class="event-details-container">
    <!-- Event Hero Section -->
    <section class="event-hero" style="height: 500px; background: url('https://images.unsplash.com/photo-1519671482677-504be0271101?w=1200&h=500&fit=crop') center/cover; position: relative;" data-aos="fade-up">
        <div class="position-absolute w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);"></div>
        <div class="container h-100 d-flex align-items-end" style="position: relative; z-index: 1; color: white; padding-bottom: 30px;">
            <div>
                <h1 class="display-4 fw-bold mb-2">Summer Music Festival</h1>
                <div class="d-flex gap-3">
                    <span class="badge bg-primary fs-6">Concert</span>
                    <div class="rating" style="color: white;">
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star-half-alt text-warning"></i>
                        <span class="ms-2">4.8 (2.5K reviews)</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Event Details -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Main Content -->
                <div class="col-lg-8" data-aos="fade-up">
                    <!-- Quick Info -->
                    <div class="quick-info mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="info-card">
                                    <i class="fas fa-calendar-days"></i>
                                    <p class="small text-muted">Date</p>
                                    <h6 class="fw-bold">June 15, 2026</h6>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card">
                                    <i class="fas fa-clock"></i>
                                    <p class="small text-muted">Time</p>
                                    <h6 class="fw-bold">6:00 PM - 11:00 PM</h6>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card">
                                    <i class="fas fa-map-pin"></i>
                                    <p class="small text-muted">Location</p>
                                    <h6 class="fw-bold">Central Park, NYC</h6>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card">
                                    <i class="fas fa-ticket"></i>
                                    <p class="small text-muted">Price</p>
                                    <h6 class="fw-bold text-primary">$85</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Event Description -->
                    <div class="mb-5">
                        <h3 class="fw-bold mb-3">About This Event</h3>
                        <p class="lead">Join us for an unforgettable night of live music at the prestigious Summer Music Festival. Experience performances from top artists and international stars across multiple stages.</p>
                        <p>This year's festival features a carefully curated lineup of performers spanning various genres including rock, pop, electronic, and world music. Whether you're a music enthusiast or just looking for a fun evening out, this event promises entertainment for everyone.</p>
                    </div>

                    <!-- Event Schedule -->
                    <div class="mb-5">
                        <h3 class="fw-bold mb-3">Event Schedule</h3>
                        <div class="timeline">
                            <div class="timeline-item">
                                <div class="timeline-time">5:00 PM</div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold">Gates Open</h6>
                                    <p class="text-muted small">Welcome reception and venue access</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-time">6:00 PM</div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold">Opening Performance</h6>
                                    <p class="text-muted small">Local indie band performance</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-time">7:30 PM</div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold">Main Stage Artists</h6>
                                    <p class="text-muted small">Featured international performers</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-time">9:00 PM</div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold">Headline Performance</h6>
                                    <p class="text-muted small">Closing performance by the headliner</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Event Gallery -->
                    <div class="mb-5">
                        <h3 class="fw-bold mb-3">Event Gallery</h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="gallery-thumb" style="background: url('https://images.unsplash.com/photo-1519671482677-504be0271101?w=300&h=300&fit=crop') center/cover; cursor: pointer; border-radius: 8px; height: 200px;"></div>
                            </div>
                            <div class="col-md-4">
                                <div class="gallery-thumb" style="background: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=300&h=300&fit=crop') center/cover; cursor: pointer; border-radius: 8px; height: 200px;"></div>
                            </div>
                            <div class="col-md-4">
                                <div class="gallery-thumb" style="background: url('https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=300&h=300&fit=crop') center/cover; cursor: pointer; border-radius: 8px; height: 200px;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Organizer Info -->
                    <div class="organizer-card mb-5">
                        <h3 class="fw-bold mb-3">Organizer</h3>
                        <div class="d-flex align-items-center">
                            <div class="organizer-avatar" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem;">
                                <i class="fas fa-music"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="fw-bold mb-0">Festival Productions Inc.</h6>
                                <p class="text-muted small mb-2">Professional event organizers</p>
                                <button class="btn btn-sm btn-outline-primary" onclick="showToast('Follow feature coming soon!')">
                                    <i class="fas fa-heart me-1"></i>Follow
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Reviews Section -->
                    <div>
                        <h3 class="fw-bold mb-3">Recent Reviews</h3>
                        <div class="review-item mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); width: 40px; height: 40px; border-radius: 50%; margin-right: 10px;"></div>
                                <div>
                                    <h6 class="fw-bold mb-0">Sarah Mitchell</h6>
                                    <div class="rating small">
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                    </div>
                                </div>
                            </div>
                            <p class="text-muted">"Amazing event! The organization was perfect and the performances were incredible. Definitely attending next year!"</p>
                        </div>

                        <div class="review-item">
                            <div class="d-flex align-items-center mb-2">
                                <div style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); width: 40px; height: 40px; border-radius: 50%; margin-right: 10px;"></div>
                                <div>
                                    <h6 class="fw-bold mb-0">John Thompson</h6>
                                    <div class="rating small">
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                    </div>
                                </div>
                            </div>
                            <p class="text-muted">"Great lineup of artists. The only downside was the parking situation, but overall a fantastic experience."</p>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                    <!-- Booking Card -->
                    <div class="booking-card sticky-top" style="top: 100px;">
                        <div class="mb-4">
                            <h3 class="fw-bold">$85</h3>
                            <p class="text-muted">per ticket</p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Quantity</label>
                            <div class="input-group">
                                <button class="btn btn-outline-secondary" onclick="decreaseQty()">−</button>
                                <input type="number" class="form-control text-center" id="ticketQty" value="1" min="1" max="10">
                                <button class="btn btn-outline-secondary" onclick="increaseQty()">+</button>
                            </div>
                        </div>

                        <div class="booking-summary mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span id="subtotal">$85</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Service Fee</span>
                                <span id="fee">$5</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between fw-bold">
                                <span>Total</span>
                                <span id="total">$90</span>
                            </div>
                        </div>

                        <button class="btn btn-primary w-100 fw-bold py-3 mb-3" onclick="proceedToBooking()">
                            <i class="fas fa-ticket me-2"></i>Book Now
                        </button>

                        <button class="btn btn-outline-primary w-100" onclick="showToast('Added to wishlist!')">
                            <i class="fas fa-heart me-2"></i>Save to Wishlist
                        </button>

                        <hr>

                        <!-- Share Section -->
                        <div>
                            <p class="text-muted small mb-3">Share this event</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-light btn-sm flex-grow-1" onclick="showToast('Sharing feature coming soon!')">
                                    <i class="fab fa-facebook"></i>
                                </button>
                                <button class="btn btn-light btn-sm flex-grow-1" onclick="showToast('Sharing feature coming soon!')">
                                    <i class="fab fa-twitter"></i>
                                </button>
                                <button class="btn btn-light btn-sm flex-grow-1" onclick="showToast('Sharing feature coming soon!')">
                                    <i class="fab fa-whatsapp"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
function increaseQty() {
    const qty = document.getElementById('ticketQty');
    qty.value = Math.min(parseInt(qty.value) + 1, 10);
    updatePrice();
}

function decreaseQty() {
    const qty = document.getElementById('ticketQty');
    qty.value = Math.max(parseInt(qty.value) - 1, 1);
    updatePrice();
}

function updatePrice() {
    const qty = parseInt(document.getElementById('ticketQty').value);
    const pricePerTicket = 85;
    const subtotal = qty * pricePerTicket;
    const fee = subtotal * 0.06;
    const total = subtotal + fee;

    document.getElementById('subtotal').textContent = '$' + subtotal;
    document.getElementById('fee').textContent = '$' + Math.round(fee);
    document.getElementById('total').textContent = '$' + Math.round(total);
}

function proceedToBooking() {
    const user = JSON.parse(localStorage.getItem('currentUser'));
    if (!user) {
        showToast('Please login to book');
        window.location.href = '/Login';
        return;
    }
    window.location.href = '/Booking';
}

document.addEventListener('DOMContentLoaded', function() {
    updatePrice();
});
</script>
