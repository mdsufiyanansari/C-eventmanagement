@page

<!-- Signup Page -->
<div class="auth-container">
    <div class="auth-wrapper" data-aos="fade-up">
        <div class="auth-box">
            <div class="auth-header text-center mb-4">
                <i class="fas fa-calendar-star auth-icon"></i>
                <h2 class="fw-bold mt-3">Create Account</h2>
                <p class="text-muted">Join EventPro community today</p>
            </div>

            <form onsubmit="handleSignup(event)" id="signupForm">
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" class="form-control" placeholder="John Doe" name="fullName" id="fullName" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" placeholder="your@email.com" name="email" id="signupEmail" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input type="tel" class="form-control" placeholder="+1 (555) 000-0000" name="phone" id="signupPhone" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control" id="signupPassword" placeholder="Min. 8 characters" name="password" required>
                        <button class="btn btn-outline-secondary" type="button" onclick="toggleSignupPassword()">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm password" name="confirmPassword" required>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="termsCheck" required>
                    <label class="form-check-label" for="termsCheck">
                        I agree to the <a href="#" class="text-decoration-none">Terms & Conditions</a>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                    <i class="fas fa-user-plus me-2"></i>Create Account
                </button>
            </form>

            <div class="divider my-4">
                <span>or continue with</span>
            </div>

            <div class="social-login">
                <button class="btn btn-light w-100 mb-2" onclick="showToast('Social signup coming soon!')">
                    <i class="fab fa-google"></i> Google
                </button>
                <button class="btn btn-light w-100 mb-2" onclick="showToast('Social signup coming soon!')">
                    <i class="fab fa-facebook"></i> Facebook
                </button>
                <button class="btn btn-light w-100" onclick="showToast('Social signup coming soon!')">
                    <i class="fab fa-apple"></i> Apple
                </button>
            </div>

            <div class="auth-footer text-center mt-4">
                <p class="mb-0">
                    Already have an account? 
                    <a href="/Login" class="text-decoration-none fw-bold">Sign in</a>
                </p>
            </div>
        </div>

        <!-- Decorative Elements -->
        <div class="auth-decoration">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
        </div>
    </div>
</div>

<script>
    // Check if already logged in
    document.addEventListener('DOMContentLoaded', function() {
        if (isLoggedIn()) {
            showToast('You are already logged in!', 'info');
            setTimeout(() => {
                window.location.href = '/Dashboard';
            }, 1500);
        }
    });
</script>
