function displayEvents(events) {
    const grid = document.getElementById('eventsGrid');
    grid.innerHTML = '';

    if (events.length === 0) {
        grid.innerHTML = '<div class="col-12 text-center py-5"><i class="fas fa-search" style="font-size: 3rem; color: #ddd;"></i><p class="text-muted mt-3">No events found</p></div>';
        return;
    }

    events.forEach((event, index) => {
        const eventCard = document.createElement('div');
        eventCard.className = 'col-md-6 col-lg-4';
        eventCard.innerHTML = `
            <div class="event-list-card">
                <div class="event-list-image" style="background: url('${event.image}') center/cover;"></div>
                <div class="event-list-content">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-bold mb-0">${event.title}</h6>
                        <span class="badge bg-primary">${event.category}</span>
                    </div>
                    <p class="text-muted small mb-2">
                        <i class="fas fa-calendar"></i> ${new Date(event.date).toLocaleDateString()}<br>
                        <i class="fas fa-map-pin"></i> ${event.location}
                    </p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-primary fw-bold">$${event.price}</span>
                        <div class="rating">
                            <i class="fas fa-star text-warning"></i>
                            <span class="ms-1">${event.rating}</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm w-100" onclick="viewEventDetails(${event.id})">
                            <i class="fas fa-info-circle"></i> Details
                        </button>
                        <button class="btn btn-primary btn-sm w-100" onclick="bookEvent(${event.id})">
                            <i class="fas fa-ticket"></i> Book
                        </button>
                    </div>
                </div>
            </div>
        `;
        grid.appendChild(eventCard);
    });
}

function filterEvents() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const category = document.getElementById('categoryFilter').value;
    const priceRange = document.getElementById('priceFilter').value;

    let filtered = sampleEvents.filter(event => {
        const matchesSearch = event.title.toLowerCase().includes(search) || event.location.toLowerCase().includes(search);
        const matchesCategory = !category || event.category === category;
        
        let matchesPrice = true;
        if (priceRange) {
            if (priceRange === '0-50') matchesPrice = event.price <= 50;
            else if (priceRange === '50-100') matchesPrice = event.price >= 50 && event.price <= 100;
            else if (priceRange === '100-200') matchesPrice = event.price >= 100 && event.price <= 200;
            else if (priceRange === '200+') matchesPrice = event.price >= 200;
        }

        return matchesSearch && matchesCategory && matchesPrice;
    });

    displayEvents(filtered);
}

function viewEventDetails(eventId) {
    const event = sampleEvents.find(e => e.id === eventId);
    if (event) {
        document.getElementById('modalEventTitle').textContent = event.title;
        document.getElementById('eventModalContent').innerHTML = `
            <div class="row">
                <div class="col-md-6">
                    <img src="${event.image}" class="img-fluid rounded" style="height: 300px; object-fit: cover;">
                </div>
                <div class="col-md-6">
                    <p><strong>Category:</strong> ${event.category}</p>
                    <p><strong>Date:</strong> ${new Date(event.date).toLocaleDateString()}</p>
                    <p><strong>Time:</strong> ${event.time}</p>
                    <p><strong>Location:</strong> ${event.location}</p>
                    <p><strong>Price:</strong> $${event.price}</p>
                    <p><strong>Rating:</strong> <i class="fas fa-star text-warning"></i> ${event.rating}</p>
                    <p><strong>Description:</strong> ${event.description}</p>
                </div>
            </div>
        `;
        const modal = new bootstrap.Modal(document.getElementById('eventModal'));
        modal.show();
    }
}

function bookEvent(eventId) {
    const user = JSON.parse(localStorage.getItem('currentUser'));
    if (!user) {
        showToast('Please login to book events');
        window.location.href = '/Login';
        return;
    }
    
    window.location.href = `/Booking?eventId=${eventId}`;
}

function filterCategory(category) {
    document.getElementById('categoryFilter').value = category;
    filterEvents();
    document.querySelector('main').scrollIntoView({ behavior: 'smooth' });
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
    displayEvents(sampleEvents);
});
</script>