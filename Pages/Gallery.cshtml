        category: 'Party',
        title: 'Party Decorations'
    }
];

function displayGallery(images) {
    const grid = document.getElementById('galleryGrid');
    grid.innerHTML = '';

    images.forEach((img, index) => {
        const item = document.createElement('div');
        item.className = 'gallery-item';
        item.innerHTML = `
            <div class="gallery-image-wrapper">
                <img src="${img.src}" alt="${img.title}" class="gallery-image" onclick="openLightbox('${img.src}', '${img.title}')">
                <div class="gallery-overlay">
                    <div class="gallery-info">
                        <h6 class="fw-bold">${img.title}</h6>
                        <p class="text-white small mb-0">${img.category}</p>
                        <button class="btn btn-sm btn-light mt-2" onclick="openLightbox('${img.src}', '${img.title}')">
                            <i class="fas fa-search-plus"></i> View
                        </button>
                    </div>
                </div>
            </div>
        `;
        grid.appendChild(item);
    });
}

function filterGallery(category) {
    let filtered = galleryImages;
    if (category !== 'all') {
        filtered = galleryImages.filter(img => img.category === category);
    }
    displayGallery(filtered);
}

function openLightbox(src, caption) {
    document.getElementById('lightboxImage').src = src;
    document.getElementById('lightboxCaption').textContent = caption;
    const modal = new bootstrap.Modal(document.getElementById('lightboxModal'));
    modal.show();
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
    displayGallery(galleryImages);
});
</script>